{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, notifications, clipboard, and opening https links in the default browser.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        }
      ]
    }
  ]
}
